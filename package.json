{
  "name": "snowy-river-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser version of the card game Snowy River",
  "scripts": {
    "dev": "npx http-server -p 8080 -c-1",
    "init": "node tools/init-game.mjs",
    "test": "node tests/run-all.mjs",
    "test:engine": "node tests/run-all.mjs --engine",
    "sim": "node tests/sim.mjs",
    "test:ui": "node tests/ui-browser.mjs --require",
    "test:browser": "node tests/ui-browser.mjs --require && node tests/stats-browser.mjs --require",
    "qa": "node tests/qa/qa-run.mjs",
    "sweep": "node tests/qa/sweep.mjs"
  }
}
